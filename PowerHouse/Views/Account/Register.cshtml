@model PowerHouse.VM.RegisterViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>PowerHouse - إنشاء حساب</title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{--primary:#f59e0b;--primary-dark:#d97706;--bg:#0f0f0f;--bg2:#1a1a1a;--bg3:#242424;--border:#2e2e2e;--text:#f1f1f1;--text-muted:#888;--red:#ef4444;--radius:12px}
body{font-family:'Cairo',Arial,sans-serif;background:var(--bg);color:var(--text);direction:rtl;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:2rem}
.card{background:var(--bg2);border:1px solid var(--border);border-radius:20px;padding:2.5rem;width:100%;max-width:480px;box-shadow:0 4px 40px rgba(0,0,0,0.5)}
.logo{text-align:center;margin-bottom:1.5rem}
.logo-icon{font-size:3rem;display:block}
.logo h1{font-size:2.2rem;font-weight:900;color:var(--primary);margin:.3rem 0}
.logo p{color:var(--text-muted);font-size:.9rem}
.fg{margin-bottom:1.1rem}
.fg label{display:block;font-size:.85rem;font-weight:700;color:var(--text-muted);margin-bottom:6px}
.fi{width:100%;background:var(--bg3);border:1px solid var(--border);color:var(--text);padding:11px 14px;border-radius:10px;font-family:'Cairo',Arial,sans-serif;font-size:.95rem;direction:rtl;outline:none;transition:border-color .2s}
.fi:focus{border-color:var(--primary)}
.btn{width:100%;background:var(--primary);color:#000;padding:12px;border-radius:10px;font-family:'Cairo',Arial,sans-serif;font-weight:900;font-size:1rem;border:none;cursor:pointer;margin-top:.5rem;transition:background .2s}
.btn:hover{background:var(--primary-dark)}
.footer-link{text-align:center;margin-top:1.2rem;color:var(--text-muted);font-size:.9rem}
.footer-link a{color:var(--primary);text-decoration:none;font-weight:700}
.err{color:var(--red);font-size:.8rem;margin-top:4px;display:block}
.val-sum{background:rgba(239,68,68,.1);border:1px solid var(--red);color:var(--red);border-radius:10px;padding:12px;margin-bottom:1rem;font-size:.85rem}
.val-sum ul{padding-right:1rem}
</style>
</head>
<body>
<div class="card">
  <div class="logo">
    <span class="logo-icon">⚡</span>
    <h1>PowerHouse</h1>
    <p>إنشاء حساب جديد</p>
  </div>
  <form asp-action="Register" asp-controller="Account" method="post">
    <div asp-validation-summary="All" class="val-sum"></div>
    <div class="fg">
      <label>الاسم الكامل</label>
      <input asp-for="Name" class="fi" placeholder="اسمك هنا"/>
      <span asp-validation-for="Name" class="err"></span>
    </div>
    <div class="fg">
      <label>رقم الموبايل</label>
      <input asp-for="Phone" class="fi" placeholder="01xxxxxxxxx"/>
      <span asp-validation-for="Phone" class="err"></span>
    </div>
    <div class="fg">
      <label>كلمة المرور</label>
      <input asp-for="Password" type="password" class="fi" placeholder="••••••"/>
      <span asp-validation-for="Password" class="err"></span>
    </div>
    <div class="fg">
      <label>تأكيد كلمة المرور</label>
      <input asp-for="ConfirmPassword" type="password" class="fi" placeholder="••••••"/>
      <span asp-validation-for="ConfirmPassword" class="err"></span>
    </div>
    <div class="fg">
      <label>الفرع الأساسي</label>
      <select asp-for="MainBranchId" class="fi">
        <option value="">-- اختر الفرع --</option>
        @foreach (var b in (List<Branch>)ViewBag.Branches)
        {
            <option value="@b.Id">@b.Name</option>
        }
      </select>
      <span asp-validation-for="MainBranchId" class="err"></span>
    </div>
    <button type="submit" class="btn">⚡ إنشاء الحساب</button>
  </form>
  <p class="footer-link">عندك حساب؟ <a href="/Account/Login">ادخل هنا</a></p>
</div>
</body>
</html>
